# ─────────────────────────────────────────────────────────────
# Clinical Trial Matcher — .gitignore
# Optimized for a Python + FastAPI + React/Vite + PostgreSQL + LLM stack.
# ─────────────────────────────────────────────────────────────

# ── Environment & Secrets ────────────────────────────────────
# NEVER commit real credentials. Create .env locally from the
# template in the README.
.env
.env.*
!.env.example
.envrc
*.pem
*.key

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Test & coverage artifacts
.pytest_cache/
pytest-cache-files-*/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.cache/

# Distribution / build packages
*.egg-info/
*.egg
.eggs/
wheelhouse/

# Type checking / linting
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.ruff_cache/
.pylint.d

# Jupyter / notebooks
.ipynb_checkpoints/

# ── Frontend (Node.js / React / Vite) ────────────────────────
node_modules/
frontend/dist/
dist/
build/
*.local

# NPM / Yarn / pnpm logs & caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# NOTE: package-lock.json and yarn.lock are intentionally TRACKED
# (committed) to guarantee reproducible installs in CI/CD.

# ── Logs & Runtime Data ──────────────────────────────────────
logs/
*.log
*.log.*
nohup.out

# Qdrant / vector store / databases
qdrant/
storage/
*.sqlite3
*.db

# Temporary directories
tmp/
temp/

# ── Editors & IDEs ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS-specific ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
