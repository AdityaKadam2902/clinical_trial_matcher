# ─────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your values.
#   cp .env.example .env
# Never commit the real .env file (see .gitignore).
# ─────────────────────────────────────────────────────────────

# ── LLM (required) ────────────────────────────────────────────
# Get a free API key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL_COMPLEX=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# ── Database (required) ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clinical_trials
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/clinical_trials

# ── Vector DB (optional) ──────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=clinical_trials

# ── External APIs (all free, no keys needed) ─────────────────
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
OPENFDA_BASE_URL=https://api.fda.gov/drug
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Pagination ────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=50
