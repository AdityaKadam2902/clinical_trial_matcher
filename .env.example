# Clinical Trial Matcher — environment template.
# Copy to .env and replace every placeholder. Never commit .env.
#
#   cp .env.example .env

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
# LOG_JSON=true
# DOCS_ENABLED=false

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters in production.
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=clinical-trial-matcher
JWT_AUDIENCE=clinical-trial-matcher-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_ENABLED=true
# Keep false in production; use scripts/create_admin.py to bootstrap admins.
ALLOW_REGISTRATION=false
PASSWORD_MIN_LENGTH=12
TRUSTED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_COUNT=0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_REQUEST_BODY_BYTES=1000000
# PATIENT_DATA_ENCRYPTION_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
# Never put real credentials in this tracked file.
# Used by `docker compose` to create the database container.
POSTGRES_USER=ctm
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=clinical_trials
# Direct/local connections (Docker Compose overrides these to the `db` host).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/clinical_trials
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/clinical_trials
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
# Use `alembic upgrade head` in every shared/production environment.
AUTO_CREATE_TABLES=false

# ── Redis / rate limiting ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_MATCH=5/minute
RATE_LIMIT_READ=60/minute
RATE_LIMIT_AUTH=10/minute

# ── Vector DB (optional) ─────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=clinical_trials

# ── LLM (local by default) ───────────────────────────────────────────────────
# Production refuses non-local providers so patient data never leaves the host.
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_LLM_API_KEY=local
LOCAL_LLM_TIMEOUT_SECONDS=120
# Eligibility inference guardrails: one slow call must never hang the request.
LOCAL_LLM_MAX_ELIGIBILITY_TRIALS=3
ELIGIBILITY_TIMEOUT_SECONDS=90
PIPELINE_BUDGET_SECONDS=180

# Optional development fallback only. Leave blank when using a local model.
GROQ_API_KEY=
GROQ_MODEL_COMPLEX=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant

# ── External APIs ────────────────────────────────────────────────────────────
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
OPENFDA_BASE_URL=https://api.fda.gov/drug
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
EXTERNAL_API_TIMEOUT_SECONDS=30

# ── Pagination ───────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=50

# ── Observability ────────────────────────────────────────────────────────────
# SENTRY_DSN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true
